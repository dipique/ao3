{
  "compilerOptions": {
    "target": "ESNext",
    // The options UI is all .vue SFCs with template blocks — it has no .tsx of
    // its own — so the only JSX this project ever sees is in the src/common
    // files it imports, which are written against our own hyperscript (#dom),
    // not Vue's. Pointing jsxImportSource at Vue typed those files' elements as
    // VNodes and broke every one of them; these match tsconfig.common.json.
    "jsx": "react",
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "moduleDetection": "force",
    "useDefineForClassFields": true,
    "module": "preserve",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    // typed-query-selector is here for src/common, which this project pulls in
    // and which is written against the element types it infers.
    "types": [
      "node",
      "firefox-webext-browser",
      "vite/client",
      "typed-query-selector"
    ],
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitThis": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": false,
    "noEmit": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noErrorTruncation": true
  },
  "include": [
    "src/options_ui/**/*.ts",
    "src/options_ui/**/*.vue",
    "src/types/auto-imports.d.ts",
    "src/types/components.d.ts",
    "src/types/vue-global.d.ts",
    "src/types/vue-unocss-attributify.d.ts",
    "src/types/env.d.ts",
    "src/types/icons.d.ts"
  ],
  "vueCompilerOptions": {
    "strictTemplates": true
  }
}
