{
  "compilerOptions": {
    "target": "ESNext",
    "jsx": "react",
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "moduleDetection": "force",
    "useDefineForClassFields": true,
    "module": "preserve",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    // This project pulls in src/common, so it needs the same ambient types that
    // tsconfig.common.json gives those files: typed-query-selector for the
    // element types querySelector infers, vite/client for the `?inline` imports.
    "types": [
      "node",
      "firefox-webext-browser",
      "typed-query-selector",
      "vite/client"
    ],
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitThis": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": false,
    "noEmit": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noErrorTruncation": true
  },
  "include": [
    "src/manifest.ts",
    "src/background/**/*.ts",
    "src/types/env.d.ts",
    "src/types/icons.d.ts"
  ]
}
